# ---------- Frontend (set in Vercel → Project → Settings → Environment Variables) ----------
# Public URL of the site. Set this to your custom domain once it is attached, e.g. https://www.yourdomain.com
SITE_URL=
# Optional. Public base URL of the FastAPI backend (e.g. https://api.yourdomain.com).
# Leave empty to run fully in the browser (users paste their own free Groq/Gemini keys).
API_BASE=

# ---------- Backend (copy to backend/.env — never commit it) ----------
GROQ_API_KEY=
GEMINI_API_KEY=
CORS_ORIGINS=http://localhost:3000,https://dictionary.vercel.app
# JSON map of API key -> role (guest|user|moderator|admin). Generate long random keys.
API_KEYS={}
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://dictionary:change-this-password@postgres:5432/dictionary
QDRANT_URL=http://qdrant:6333
VISION_URL=http://vision:8001
GROUNDING_THRESHOLD=0.35
POSTGRES_PASSWORD=change-this-password
